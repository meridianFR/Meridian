# ───────────────────────────────────────────────────────────────────────────
# Meridian — variables d'environnement (paiement + comptes)
# Copie ce fichier en `.env.local` et remplis les valeurs. NE COMMITE JAMAIS
# `.env.local` (déjà ignoré par .gitignore). Guide complet : docs/paiement-setup.md
# ───────────────────────────────────────────────────────────────────────────

# URL publique du site (sans slash final).
# En local : http://localhost:3000 — en prod : https://meridian.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Auth + base de données) ───────────────────────────────────────
# Tableau de bord Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...        # clé "anon public"

# ⚠️ SECRET — service role (pouvoir admin, bypass RLS). Côté serveur UNIQUEMENT.
# Ne jamais préfixer NEXT_PUBLIC_. Utilisée par le webhook Stripe.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Stripe (paiement) ───────────────────────────────────────────────────────
# Dashboard Stripe → Developers → API keys (utilise les clés TEST pour démarrer)
STRIPE_SECRET_KEY=sk_test_xxx

# Dashboard Stripe → Developers → Webhooks → (ton endpoint) → Signing secret
# En local, fourni par `stripe listen` (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# IDs de prix récurrents créés dans Stripe (Products) — PAS les IDs produit.
STRIPE_PRICE_MONTHLY=price_xxx   # 19 €/mois
STRIPE_PRICE_ANNUAL=price_xxx    # 190 €/an
